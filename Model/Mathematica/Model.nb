Cell[CellGroupData[{

Cell["2. Funci\[OAcute]n -- el modelo en cada nodo", "Section",ExpressionUUID->"b5d2d794-ed19-2646-b668-053b05cd7e88"],

Cell["\<\
Mismos par\[AAcute]metros y ecuaciones del paper de un solo nodo, replicados \
en cada localidad. Diaphorina citri (x1) y Tamarixia radiata (x3) pueden \
moverse entre nodos vecinos (tasas Dd, Dt); brotes (x2) y vigor de planta \
(x4) se quedan en su nodo.\
\>", "Text",ExpressionUUID->"1b599565-4090-7549-89c6-65a51df95ae4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"as", " ", "=", " ", "0.000555"}], ";", " ", 
  RowBox[{"cs", " ", "=", " ", "0.005"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"param1", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "0.2"}], ",", " ", "0.04", ",", " ", 
     RowBox[{"-", "0.01"}], ",", " ", "as", ",", " ", "cs"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"param2", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "0.72"}], ",", " ", 
     RowBox[{"-", "0.01"}], ",", " ", "0.054", ",", " ", "as", ",", " ", 
     "cs"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"param3", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "0.3"}], ",", " ", "0.01", ",", " ", "as", ",", " ", "cs"}],
     "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"param4", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.72", ",", " ", 
     RowBox[{"-", "0.072"}], ",", " ", "as", ",", " ", "cs"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"params", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "param1", ",", " ", "param2", ",", " ", "param3", ",", " ", "param4"}], 
    "}"}]}], ";"}]}], "Code",
 InitializationCell->False,
 CellLabel->"In[12]:=",ExpressionUUID->"91373ba9-592d-394a-8777-28f196f215a9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Evoluci\[OAcute]n -- resolver el sistema", "Section",ExpressionUUID->"b8c514cf-0285-f341-b799-eafaf6cd3203"],

Cell["\<\
Un brote puntual: el nodo 1 arranca con 200 Diaphorina (foco), el resto en \
20. Liberaci\[OAcute]n peri\[OAcute]dica de Tamarixia (\[Delta]=35 cada T=15) \
en todos los nodos. Difusi\[OAcute]n Dd=Dt=0.03.\
\>", "Text",ExpressionUUID->"edaa9436-cf0e-3942-b700-1d68f3fe270c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tt", " ", "=", " ", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ics", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"20", ",", " ", 
         RowBox[{"n", " ", "-", " ", "1"}]}], "]"}], ",", " ", "200"}], "]"}],
      ",", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"10", ",", " ", "n"}], "]"}], ",", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"15", ",", " ", "n"}], "]"}], ",", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"30", ",", " ", "n"}], "]"}], ",", " ", "tt"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"netData", " ", "=", " ", 
   RowBox[{"SolveNetworkData", "[", 
    RowBox[{
    "graph", ",", " ", "0.03", ",", " ", "0.03", ",", " ", "35", ",", " ", 
     "15", ",", " ", "params", ",", " ", "ics"}], "]"}]}], ";"}]}], "Code",
 InitializationCell->False,
 CellLabel->"In[18]:=",ExpressionUUID->"42fc3df4-d44c-2944-831d-59483ffa5986"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Resultados -- qu\[EAcute] pas\[OAcute] en cada nodo?", "Section",
 CellChangeTimes->{{3.999008142524229*^9, 
  3.9990081429969673`*^9}},ExpressionUUID->"471e8496-8f16-4e4e-902f-\
db2e37eef2d0"],

Cell["\<\
Diaphorina citri (x1) en cada nodo a lo largo del tiempo. El nodo 1 (el foco \
del brote) parte muy por encima del resto.\
\>", "Text",ExpressionUUID->"d343cdf3-b1bd-a449-b3e7-8c86d37e68b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"NodeIF", "[", 
        RowBox[{"netData", ",", " ", "x1", ",", " ", "i"}], "]"}], "[", "t", 
       "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "n"}], "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"t", ",", " ", "0", ",", " ", "tt"}], "}"}], ",", "\n", "  ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"\"\<Nodo \>\"", " ", "<>", " ", 
       RowBox[{"ToString", "[", "i", "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "n"}], "}"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<tiempo (u.a.)\>\"", ",", " ", "\"\<Diaphorina citri\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "  ", 
   RowBox[{"GridLines", " ", "->", " ", "Automatic"}], ",", " ", 
   RowBox[{"GridLinesStyle", " ", "->", " ", 
    RowBox[{"Directive", "[", "Dashed", "]"}]}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "Large"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]], "Code",
 InitializationCell->False,
 CellChangeTimes->{{3.9990080857394123`*^9, 3.9990081229045563`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"79397885-d47f-184f-9ff7-66ee7274363a"],

