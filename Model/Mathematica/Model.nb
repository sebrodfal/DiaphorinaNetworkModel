Cell[CellGroupData[{

Cell["5. Comparaci\[OAcute]n -- \\[QuestionMark]import\[OAcute] la red?", \
"Section",ExpressionUUID->"f7cdae53-6d48-954c-b0d9-40440d8f92d6"],

Cell["\<\
(a) El nodo 1 en la red, contra el mismo huerto aislado (modelo de un solo \
nodo, misma condici\[OAcute]n inicial). La diferencia es exactamente el \
efecto de estar conectado.\
\>", "Text",ExpressionUUID->"c7a3791e-1bf6-b549-ae72-7f74a3bcbec1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"singleSol", " ", "=", " ", 
   RowBox[{"SolveSystem", "[", 
    RowBox[{"35", ",", " ", "15", ",", " ", "params", ",", " ", 
     RowBox[{"{", 
      RowBox[{
