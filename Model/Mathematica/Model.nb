           RowBox[{"{", 
            RowBox[{"t", ",", " ", "0", ",", " ", "tt"}], "}"}], ",", "\n", 
           "        ", 
           RowBox[{"Method", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<TimeIntegration\>\"", " ", "->", 
              " ", "\"\<ExplicitRungeKutta\>\""}], "}"}]}]}], "\n", "    ", 
          "]"}]}]}], ";", "\n", "\n", "    ", 
       RowBox[{"<|", "\n", "        ", 
        RowBox[{
         RowBox[{"\"\<Solution\>\"", " ", "->", " ", "sol"}], ",", " ", 
         RowBox[{"\"\<Graph\>\"", " ", "->", " ", "graph"}], ",", " ", 
         RowBox[{"\"\<N\>\"", " ", "->", " ", "n"}], ",", "\n", "        ", 
         RowBox[{"\"\<Dd\>\"", " ", "->", " ", "Dd"}], ",", " ", 
         RowBox[{"\"\<Dt\>\"", " ", "->", " ", "Dt"}], ",", " ", 
         RowBox[{"\"\<Delta\>\"", " ", "->", " ", "\[Delta]"}], ",", " ", 
         RowBox[{"\"\<T\>\"", " ", "->", " ", "T"}], ",", " ", 
         RowBox[{"\"\<tt\>\"", " ", "->", " ", "tt"}], ",", "\n", "        ", 
         RowBox[{"\"\<ReleaseNodes\>\"", " ", "->", " ", "targets"}]}], "\n", 
        "    ", "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "NodeIF", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"NodeIF", "[", 
    RowBox[{"data_Association", ",", " ", "var_", ",", " ", "i_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{
    RowBox[{"var", "[", "i", "]"}], " ", "/.", " ", 
    RowBox[{"data", "[", "\"\<Solution\>\"", "]"}]}]}], ";"}]}], "Code",
 CellLabel->"In[1]:=",ExpressionUUID->"fe6ef1f2-1b12-2a42-8a2b-76a6a5cc910e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Red -- la topolog\[IAcute]a", "Section",ExpressionUUID->"96bf3444-7733-ad46-80cf-e18421e55a63"],

Cell["\<\
Cada nodo es una localidad (huerto). Empezamos con 5 nodos en una red tipo \
\"camino\": cada huerto solo intercambia con su vecino inmediato.\
\>", "Text",ExpressionUUID->"5632cd08-fef6-1f48-ba9f-770ed1afd364"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", " ", "=", " ", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"graph", " ", "=", " ", 
   RowBox[{"MakeTopology", "[", 
    RowBox[{"\"\<Path\>\"", ",", " ", "n"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Graph", "[", 
  RowBox[{"graph", ",", " ", 
   RowBox[{"VertexLabels", " ", "->", " ", "\"\<Name\>\""}], ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}]}], "Code",
 InitializationCell->False,
 CellLabel->"In[9]:=",ExpressionUUID->"629732c7-1b0b-2e49-9508-f4231a98cb02"],

